# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (from `npx supabase start` output or the hosted project's API settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles (MapTiler style URL incl. key, or self-hosted Protomaps style)
NEXT_PUBLIC_MAP_STYLE_URL=

# Cloudflare Turnstile (invisible) for anonymous sign-in
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google One Tap
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web Push (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=
