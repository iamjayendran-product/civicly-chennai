# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (from `npx supabase start` output or the hosted project's API settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles (MapTiler style URL incl. key, or self-hosted Protomaps style)
NEXT_PUBLIC_MAP_STYLE_URL=

# Street view on the maps (free Mapillary client token, no billing: https://www.mapillary.com/dashboard/developers).
# Leave empty to hide the street-view button.
NEXT_PUBLIC_MAPILLARY_TOKEN=

# Cloudflare Turnstile (invisible) for anonymous sign-in
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google One Tap
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web Push (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=

# GCC forwarding (server only). Reports are filed with gccservices.in/pgr after the hold.
# Off by default: set to "true" only once you're ready to file real GCC complaints.
GCC_FORWARDING_ENABLED=false
# Shared secret pg_cron sends to /api/gcc/forward; must equal the Vault secret
# gcc_forward_secret (see supabase/snippets/gcc_forwarding_setup.sql).
GCC_FORWARD_SECRET=
# GCC portal origin. Point at a local stub while testing.
GCC_BASE_URL=https://gccservices.in
# This site's public origin (links in GCC complaints, and the forwarder URL in Vault).
SITE_URL=http://localhost:3000
